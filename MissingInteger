def solution(A):
  positive_numbers = set() #create empty hashset to put all postive numbers into
  for x in A:
    if x > 0:
      positive_numbers.add(x) #adding positive numbers in A to hashset
  smallest_positve = 1 #setting first smallest possible positive
  while smallest_positve in positive_numbers:
    smallest_positve = smallest_positve + 1 #incrementing until reaching just after the largest positve in A
  return smallest_positve #returning our answer
